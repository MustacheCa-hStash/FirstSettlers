#pragma kernel CullForestScatter
#include "Assets/Shaders/ForestScatterInstance.hlsl"
StructuredBuffer<ForestScatterSource> _ForestSources;
StructuredBuffer<float4> _ForestChunks;
AppendStructuredBuffer<uint> _ForestNear, _ForestFar, _ForestCoarse;
uint _ForestSourceCount, _ForestChunkCount, _ForestFrustumEnabled, _ForestHasFar, _ForestHasCoarse;
float4 _ForestFrustum[6], _ForestDistances, _ForestCoarseDistances, _ForestDensityRings;
float3 _ForestViewer;
[numthreads(64,1,1)]
void CullForestScatter(uint3 threadID : SV_DispatchThreadID)
{
    uint id = threadID.x;
    if (id >= _ForestSourceCount) return;
    ForestScatterSource source = _ForestSources[id];
    uint slot = (uint)source.selection.y;
    if (slot >= _ForestChunkCount) return;
    float4 chunk = _ForestChunks[slot];
    // Range ownership also rejects old records after a block or chunk slot is reused.
    if (chunk.z < .5 || id < (uint)chunk.x || id >= (uint)(chunk.x + chunk.y)) return;
    float distanceToViewer = length(source.sphere.xz - _ForestViewer.xz);
    if (distanceToViewer > _ForestDistances.x + source.sphere.w) return;
    float ring=distanceToViewer/_ForestCoarseDistances.z;
    float density=ring<=3?_ForestDensityRings.x: ring<=6?lerp(_ForestDensityRings.x,_ForestDensityRings.y,saturate((ring-3)/3)):
        ring<=10?lerp(_ForestDensityRings.y,_ForestDensityRings.z,saturate((ring-6)/4)):
        lerp(_ForestDensityRings.z,_ForestDensityRings.w,saturate((ring-10)/4));
    if(source.selection.z>=density)return;
    if (_ForestFrustumEnabled != 0)
        for (uint p=0;p<6;p++)
            if (dot(_ForestFrustum[p].xyz,source.sphere.xyz)+_ForestFrustum[p].w < -source.sphere.w) return;
    float blend = smoothstep(_ForestDistances.y,_ForestDistances.z,distanceToViewer);
    if (_ForestHasCoarse != 0 && source.selection.w<smoothstep(_ForestCoarseDistances.x,_ForestCoarseDistances.y,distanceToViewer)) _ForestCoarse.Append(id);
    else if (_ForestHasFar != 0 && source.selection.x < blend) _ForestFar.Append(id);
    else _ForestNear.Append(id);
}
