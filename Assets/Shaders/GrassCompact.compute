#pragma kernel CullGrass
#pragma kernel PrefixGrass
#pragma kernel ScatterGrass
#include "Assets/Shaders/GrassIndirectInstance.hlsl"

StructuredBuffer<GrassIndirectInstance> _GrassInstances;
RWStructuredBuffer<uint> _GrassOffsets;
RWStructuredBuffer<uint> _GrassGroups;
RWStructuredBuffer<uint> _GrassVisibleIndices;
RWStructuredBuffer<uint> _GrassArgs;
uint _GrassCount, _GrassGroupCount, _GrassFrustumEnabled;
float4 _GrassFrustum[6];
float3 _GrassMeshCenter, _GrassMeshExtents, _GrassWindPadding;
groupshared uint Selected[64];

[numthreads(64, 1, 1)]
void CullGrass(uint3 id : SV_DispatchThreadID, uint lane : SV_GroupIndex, uint3 group : SV_GroupID)
{
    bool visible = id.x < _GrassCount;
    if (visible && _GrassFrustumEnabled != 0)
    {
        float4x4 transform = _GrassInstances[id.x].objectToWorld;
        float3 center = mul(transform, float4(_GrassMeshCenter, 1)).xyz;
        float3 extents = mul(abs((float3x3)transform), _GrassMeshExtents) + _GrassWindPadding;
        for (uint p = 0; p < 6; p++)
            if (dot(_GrassFrustum[p].xyz, center) + _GrassFrustum[p].w +
                dot(abs(_GrassFrustum[p].xyz), extents) < 0) visible = false;
    }
    Selected[lane] = visible ? 1 : 0;
    GroupMemoryBarrierWithGroupSync();
    uint offset = 0;
    for (uint i = 0; i < lane; i++) offset += Selected[i];
    if (id.x < _GrassCount) _GrassOffsets[id.x] = visible ? offset : 0xffffffff;
    if (lane == 63) _GrassGroups[group.x] = offset + Selected[lane];
}

[numthreads(1, 1, 1)]
void PrefixGrass(uint3 id : SV_DispatchThreadID)
{
    uint offset = 0;
    for (uint g = 0; g < _GrassGroupCount; g++)
    {
        uint count = _GrassGroups[g];
        _GrassGroups[g] = offset;
        offset += count;
    }
    _GrassArgs[1] = offset;
}

[numthreads(64, 1, 1)]
void ScatterGrass(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID)
{
    if (id.x >= _GrassCount) return;
    uint offset = _GrassOffsets[id.x];
    if (offset != 0xffffffff) _GrassVisibleIndices[_GrassGroups[group.x] + offset] = id.x;
}

// Candidate discovery remains deterministic Burst CPU work. Resident GPU selection uses these
// same candidates for both meshes, with no readback or per-frame CPU matrix rebuilding.
#pragma kernel CullResidentGrass
StructuredBuffer<float4> _ResidentSlots;
AppendStructuredBuffer<uint> _ResidentVisible;
uint _ResidentSlotSize, _ResidentSlotCount, _ResidentRepresentation;
int _ResidentForce;
float3 _ResidentViewer;
float4 _ResidentDensities, _ResidentDistances;
float ResidentDensity(float d)
{
    if (d <= 3) return _ResidentDensities.x;
    if (d <= 6) return lerp(_ResidentDensities.x, _ResidentDensities.y, saturate((d-3)/3));
    if (d <= 10) return lerp(_ResidentDensities.y, _ResidentDensities.z, saturate((d-6)/4));
    return lerp(_ResidentDensities.z, _ResidentDensities.w, saturate((d-10)/4));
}
[numthreads(64, 1, 1)]
void CullResidentGrass(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x / _ResidentSlotSize;
    if (slot >= _ResidentSlotCount) return;
    float4 metadata = _ResidentSlots[slot];
    if (id.x % _ResidentSlotSize >= (uint)metadata.x) return;
    GrassIndirectInstance instance = _GrassInstances[id.x];
    float3 position = mul(instance.objectToWorld, float4(0,0,0,1)).xyz;
    float distance = length(position.xz - _ResidentViewer.xz);
    float blend = _ResidentForce < 0 ? metadata.y : (float)_ResidentForce;
    float edge = 1 - smoothstep(_ResidentDistances.y - _ResidentDistances.z, _ResidentDistances.y, distance);
    float density = lerp(ResidentDensity(distance / _ResidentDistances.x), _ResidentDistances.w, blend) * edge;
    if (instance.data.z >= density) return;
    uint representation = instance.data.w < blend ? 1 : 0;
    if (representation != _ResidentRepresentation) return;
    if (_GrassFrustumEnabled != 0)
    {
        float3 center = mul(instance.objectToWorld, float4(_GrassMeshCenter, 1)).xyz;
        float3 extents = mul(abs((float3x3)instance.objectToWorld), _GrassMeshExtents) + _GrassWindPadding;
        for (uint p = 0; p < 6; p++)
            if (dot(_GrassFrustum[p].xyz, center) + _GrassFrustum[p].w + dot(abs(_GrassFrustum[p].xyz), extents) < 0) return;
    }
    _ResidentVisible.Append(id.x);
}
