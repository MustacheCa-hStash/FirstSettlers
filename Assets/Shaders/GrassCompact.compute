#include "Assets/Shaders/GrassIndirectInstance.hlsl"
StructuredBuffer<GrassIndirectInstance> _GrassInstances;
StructuredBuffer<float4> _ResidentSlots;
uint _ResidentSlotSize, _ResidentSlotCount, _GrassFrustumEnabled;
float4 _GrassFrustum[6];
float3 _ResidentViewer;
float4 _ResidentDensities, _ResidentDistances;
float ResidentDensity(float d)
{
    if (d <= 3) return _ResidentDensities.x;
    if (d <= 6) return lerp(_ResidentDensities.x, _ResidentDensities.y, saturate((d-3)/3));
    if (d <= 10) return lerp(_ResidentDensities.y, _ResidentDensities.z, saturate((d-6)/4));
    return lerp(_ResidentDensities.z, _ResidentDensities.w, saturate((d-10)/4));
}
// Select the representation once, then test its own mesh/wind bounds and route it.
#pragma kernel CullResidentGrassAll
AppendStructuredBuffer<uint> _ResidentMeadowNear, _ResidentMeadowFar;
AppendStructuredBuffer<uint> _ResidentForestNear, _ResidentForestFar;
uint _ResidentSplitForest, _ResidentChannels;
float4 _ResidentForces;
float4 _ResidentCenters[4], _ResidentExtents[4], _ResidentWind[4];
[numthreads(64, 1, 1)]
void CullResidentGrassAll(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x / _ResidentSlotSize;
    if (slot >= _ResidentSlotCount) return;
    float4 metadata = _ResidentSlots[slot];
    if (id.x % _ResidentSlotSize >= (uint)metadata.x) return;
    GrassIndirectInstance instance = _GrassInstances[id.x];
    uint biome = _ResidentSplitForest != 0 && instance.data.x >= 0.5 ? 1 : 0;
    float force = biome == 0 ? _ResidentForces.x : _ResidentForces.y;
    float blend = force < 0 ? metadata.y : force;
    float3 position = mul(instance.objectToWorld, float4(0,0,0,1)).xyz;
    float distance = length(position.xz - _ResidentViewer.xz);
    float edge = 1 - smoothstep(_ResidentDistances.y - _ResidentDistances.z, _ResidentDistances.y, distance);
    float density = lerp(ResidentDensity(distance / _ResidentDistances.x), _ResidentDistances.w, blend) * edge;
    if (instance.data.z >= density) return;
    uint representation = instance.data.w < blend ? 1 : 0;
    uint channel = biome * 2 + representation;
    if ((_ResidentChannels & (1u << channel)) == 0) return;
    if (_GrassFrustumEnabled != 0)
    {
        float3 center = mul(instance.objectToWorld, float4(_ResidentCenters[channel].xyz, 1)).xyz;
        float3 extents = mul(abs((float3x3)instance.objectToWorld), _ResidentExtents[channel].xyz) + _ResidentWind[channel].xyz;
        for (uint p = 0; p < 6; p++)
            if (dot(_GrassFrustum[p].xyz, center) + _GrassFrustum[p].w + dot(abs(_GrassFrustum[p].xyz), extents) < 0) return;
    }
    if (channel == 0) _ResidentMeadowNear.Append(id.x);
    else if (channel == 1) _ResidentMeadowFar.Append(id.x);
    else if (channel == 2) _ResidentForestNear.Append(id.x);
    else _ResidentForestFar.Append(id.x);
}
