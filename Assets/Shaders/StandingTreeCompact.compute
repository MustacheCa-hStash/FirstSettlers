#pragma kernel SelectStandingTreeLods

struct StandingTreeSource
{
    float4x4 objectToWorld;
    float4 leaves;
    float4 bark;
    float4 appearance; // snow, always alpha shadows, max scale, shadow radius scale squared
    float4 fade;       // billboard handoff, unused, load fade, unused
};

struct StandingTreeVisible
{
    float4 fade;
    uint4 source; // source/inverse index, alpha shadows, unused, unused
};

StructuredBuffer<StandingTreeSource> _StandingTreeSources;
RWStructuredBuffer<StandingTreeVisible> _StandingTreeVisible;
RWStructuredBuffer<float4x4> _StandingTreeInverses;
RWStructuredBuffer<uint> _StandingTreeArgs;

uint _StandingTreeCount, _StandingTreeCapacity, _StandingTreeLevels;
float4 _StandingTreeFirstCommand, _StandingTreeCommandCount;
float4 _StandingTreeThresholds, _StandingTreeHalfWidths;
float4 _StandingTreeCenterRadius;
float4 _StandingTreeEyeHeight; // xyz eye, w screen height factor
float _StandingTreeForestAlphaDistanceSq;
uint _StandingTreeOrthographic, _StandingTreeCull;
float4 _StandingTreePlanes[6];

void AppendTree(uint source, uint level, float4 fade, uint alphaShadows)
{
    uint first = (uint)_StandingTreeFirstCommand[level];
    uint count = (uint)_StandingTreeCommandCount[level];
    uint destination;
    InterlockedAdd(_StandingTreeArgs[first * 5 + 1], 1, destination);
    for (uint i = 1; i < count; ++i)
        InterlockedAdd(_StandingTreeArgs[(first + i) * 5 + 1], 1);
    StandingTreeVisible visible;
    visible.source = uint4(source, alphaShadows, 0, 0);
    visible.fade = fade;
    _StandingTreeVisible[level * _StandingTreeCapacity + destination] = visible;
}

[numthreads(64, 1, 1)]
void SelectStandingTreeLods(uint id : SV_DispatchThreadID)
{
    if (id >= _StandingTreeCount) return;
    StandingTreeSource tree = _StandingTreeSources[id];
    float3 center = mul(tree.objectToWorld, float4(_StandingTreeCenterRadius.xyz, 1)).xyz;
    if (_StandingTreeCull)
    {
        float radius = _StandingTreeCenterRadius.w * tree.appearance.z;
        for (uint p = 0; p < 6; ++p)
            if (dot(_StandingTreePlanes[p], float4(center, 1)) < -radius) return;
    }

    // The world supplies TRS placement matrices. Compute their inverse once
    // per tree, shared by every vertex, pass, part, and active LOD.
    float4x4 transform = tree.objectToWorld;
    float3 x = transform._m00_m10_m20, y = transform._m01_m11_m21, z = transform._m02_m12_m22;
    x /= max(dot(x, x), 1e-12);
    y /= max(dot(y, y), 1e-12);
    z /= max(dot(z, z), 1e-12);
    float3 p = transform._m03_m13_m23;
    _StandingTreeInverses[id] = float4x4(float4(x, -dot(x, p)), float4(y, -dot(y, p)),
        float4(z, -dot(z, p)), float4(0, 0, 0, 1));
    float2 fromEye = p.xz - _StandingTreeEyeHeight.xz;
    uint alphaShadows = tree.appearance.y > .5 ||
        dot(fromEye, fromEye) < _StandingTreeForestAlphaDistanceSq * tree.appearance.w ? 1u : 0u;

    if (_StandingTreeLevels == 1)
    {
        AppendTree(id, 0, tree.fade, alphaShadows);
        return;
    }

    float height = _StandingTreeEyeHeight.w * tree.appearance.z;
    if (!_StandingTreeOrthographic)
        height /= max(.01, distance(_StandingTreeEyeHeight.xyz, center));
    uint level = 0;
    while (level + 1 < _StandingTreeLevels && height < _StandingTreeThresholds[level]) ++level;
    for (uint boundary = max(1u, level) - 1; boundary <= level && boundary + 1 < _StandingTreeLevels; ++boundary)
    {
        float threshold = _StandingTreeThresholds[boundary];
        float width = _StandingTreeHalfWidths[boundary];
        if (abs(height - threshold) < width)
        {
            float coarse = 1 - saturate((height - (threshold - width)) / (2 * width));
            AppendTree(id, boundary, float4(max(tree.fade.x, coarse), 1, tree.fade.z, 0), alphaShadows);
            AppendTree(id, boundary + 1, float4(tree.fade.x, coarse, tree.fade.z, 0), alphaShadows);
            return;
        }
    }
    AppendTree(id, level, tree.fade, alphaShadows);
}
